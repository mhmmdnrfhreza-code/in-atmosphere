{
  "name": "in-atmosphere",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:morning": "cross-env REPORT_MODE=morning tsx src/main.ts",
    "dev:rush": "cross-env REPORT_MODE=rush-hour tsx src/main.ts",
    "dev:watch": "cross-env REPORT_MODE=emergency-watch tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:morning": "cross-env REPORT_MODE=morning node dist/main.js",
    "start:rush": "cross-env REPORT_MODE=rush-hour node dist/main.js",
    "start:watch": "cross-env REPORT_MODE=emergency-watch node dist/main.js",
    "test": "vitest run",
    "preview": "serve public"
  },
  "keywords": [
    "bogor",
    "weather",
    "air-quality",
    "uv-index",
    "bmkg",
    "discord-webhook",
    "github-actions",
    "open-meteo"
  ],
  "author": "_mhmmdnrfhreza.care <mhmmdnrfhreza.career@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "description": "Automated Weather, Air Quality, UV Index, and BMKG Warning Monitor For Kota Bogor.",
  "dependencies": {
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "cross-env": "^10.1.0",
    "serve": "^14.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
